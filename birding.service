[Unit]
Description=Birding Service (YOLO RTSP)
After=network.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 安全建议：生产环境可改为专用低权限用户（如 User=birding），并相应调整 IMAGE_ROOT 目录属主
User=root
WorkingDirectory=/home/birding
# 生产默认关闭调试（非鸟不入库）；可用环境变量覆盖其它参数
Environment=DEBUG_MODE=false
# 2026-09-06 假死排查后固化：MPP 硬解 / RGA 预处理与内核页表损坏（still mapped when deleted）
# 的死亡强相关，已回退为 cv2 软解拉流；NPU 检测保留（12x 加速不受影响）。
# 复现实验确认：MPP+RGA 配置下 1.2~4.5 分钟必死，cv2+NPU 稳定 20 分钟+。
# 如需重测硬件路径：改回 RGA_ENABLED=1 / RTSP_BACKEND=mpp 后 systemctl daemon-reload && restart birding
Environment=RGA_ENABLED=0
Environment=RTSP_BACKEND=cv2
Environment=PYTHONUNBUFFERED=1
Environment=RTSP_IDLE_SEC=30
# OFFLINE 持续超过该秒数 /healthz 返回 503（配合外部巡检自愈）
Environment=OFFLINE_ALARM_SEC=600
# 停机给 lifespan 优雅退出留足时间（正常应在 1-2s 内退出）
TimeoutStopSec=15
# 主程序已内置 __main__ 入口（uvicorn.run），直接运行即可启动 Web 服务
ExecStart=/home/birding/venv/bin/python3 /home/birding/birding_service.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
